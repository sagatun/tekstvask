    "Shortcuts": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigtaster"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortkommandon"
          }
        }
      }
    },
    "Target language": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Målspråk"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Målspråk"
          }
        }
      }
    },
    "Tekstvask needs Accessibility access to copy and paste the selected text.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstvask trenger tilgang under Tilgjengelighet for å kopiere og lime inn markert tekst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstvask behöver behörighet under Hjälpmedel för att kopiera och klistra in markerad text."
          }
        }
      }
    },
    "Tekstvask Settings": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innstillinger for Tekstvask"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inställningar för Tekstvask"
          }
        }
      }
    },
    "Text already in %@ is translated to %@.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst som allerede er på %1$@, oversettes til %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Text som redan är på %1$@ översätts till %2$@."
          }
        }
      }
    },
    "Text that’s already in the target language is translated to this language instead.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst som allerede er på målspråket, oversettes til dette språket i stedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Text som redan är på målspråket översätts till det här språket i stället."
          }
        }
      }
    },
    "That shortcut is already used by “%@”.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigtasten brukes allerede av «%@»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortkommandot används redan av ”%@”."
          }
        }
      }
    },
    "The API key was rejected. Check it in Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nøkkelen ble avvist. Sjekk den i Innstillinger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nyckeln avvisades. Kontrollera den i Inställningar."
          }
        }
      }
    },
    "The text is too long. Select less text and try again.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten er for lang. Marker mindre tekst og prøv igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten är för lång. Markera mindre text och försök igen."
          }
        }
      }
    },
    "Translate": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversett"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översätt"
          }
        }
      }
    },
    "Translate to %@": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversett til %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översätt till %@"
          }
        }
      }
    },
    "You switched apps, so the result was copied to the clipboard instead.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du byttet app, så resultatet ble kopiert til utklippstavlen i stedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bytte app, så resultatet kopierades till urklipp i stället."
          }
        }
      }
    }
  }
}
