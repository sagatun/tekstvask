{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ and %@ are replaced with the target and second language.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ og %2$@ byttes ut med målspråket og andrespråket."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ och %2$@ ersätts med målspråket och andraspråket."
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgjengelighet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälpmedel"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avansert"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancerat"
          }
        }
      }
    },
    "Anthropic API error (%lld): %@": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Feil fra Anthropic API (%lld): %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fel från Anthropic API (%lld): %@"
          }
        }
      }
    },
    "Anthropic API key": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic API-nøkkel"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic API-nyckel"
          }
        }
      }
    },
    "Claude declined to process this text.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude avviste å behandle denne teksten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude avböjde att bearbeta texten."
          }
        }
      }
    },
    "Claude returned no text.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude returnerte ingen tekst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude returnerade ingen text."
          }
        }
      }
    },
    "Custom": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Egen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Egen"
          }
        }
      }
    },
    "Custom action": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Egen handling"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Egen åtgärd"
          }
        }
      }
    },
    "e.g. Shorten": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. Forkort"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "t.ex. Korta ner"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Generelt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allmänt"
          }
        }
      }
    },
    "Get an API key at console.anthropic.com": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaff en API-nøkkel på console.anthropic.com"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaffa en API-nyckel på console.anthropic.com"
          }
        }
      }
    },
    "Granted": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillatt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beviljad"
          }
        }
      }
    },
    "Haiku is the fastest and cheapest. Sonnet and Opus are slower and cost more, but follow demanding prompts better.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Haiku er raskest og billigst. Sonnet og Opus er tregere og koster mer, men følger krevende prompter bedre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Haiku är snabbast och billigast. Sonnet och Opus är långsammare och kostar mer, men följer krävande prompter bättre."
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        }
      }
    },
    "Name in the menu": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navn i menyen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namn i menyn"
          }
        }
      }
    },
    "Name it to add it to the menu and give it a shortcut. Its prompt is under Custom below.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi den et navn for å få den i menyen og gi den en hurtigtast. Prompten ligger under Egen nedenfor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge den ett namn för att få den i menyn och ge den ett kortkommando. Prompten finns under Egen nedan."
          }
        }
      }
    },
    "Open at login": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne ved pålogging"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna vid inloggning"
          }
        }
      }
    },
    "Open System Settings…": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Systeminnstillinger…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Systeminställningar…"
          }
        }
      }
    },
