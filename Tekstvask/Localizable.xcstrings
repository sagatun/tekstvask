      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakestill"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ"
          }
        }
      }
    },
