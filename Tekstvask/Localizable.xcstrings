            "state": "translated",
            "value": "Prompter"
          }
        }
      }
    },
    "Proofread": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Språkvask"
          }
        },
        "sv": {
